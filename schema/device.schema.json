{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device integration scorecard — device evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "evaluation", "scores"],
  "properties": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model"],
      "properties": {
        "vendor":           {"type": "string", "minLength": 1},
        "model":            {"type": "string", "minLength": 1},
        "category":         {"type": ["string", "null"], "description": "e.g. plate reader, HPLC, liquid handler"},
        "interface":        {"type": ["string", "null"], "description": "protocol evaluated, e.g. SiLA 2, OPC UA/LADS, REST"},
        "architecture":     {"enum": ["Native endpoint", "Vendor edge-controller", "Third-party gateway", null], "description": "C1 endpoint architecture, recorded separately from the C1 grade"},
        "firmware_version": {"type": ["string", "null"]},
        "product_url":      {"type": ["string", "null"]}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "date", "scorecard_version", "deployment", "evidence_basis"],
      "properties": {
        "evaluator":         {"type": "string", "minLength": 1, "description": "name, org, or handle (may be a pseudonym)"},
        "date":              {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "scorecard_version": {"type": "string", "description": "criteria-set version scored against, e.g. 1.0.0"},
        "deployment":        {"enum": ["standalone", "cell-integrated"]},
        "evidence_basis":    {"enum": ["vendor-docs", "hands-on-test", "integrator-report"]},
        "verified":          {"type": "boolean", "description": "true only if independently confirmed by a maintainer"}
      }
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^C[0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grade"],
          "properties": {
            "grade":    {"enum": ["Pass", "Partial", "Fail", "N/A"]},
            "note":     {"type": ["string", "null"]},
            "evidence": {"type": ["string", "null"], "description": "URL or document reference supporting the grade"}
          }
        }
      }
    },
    "vendor_response": {"type": ["string", "null"], "description": "optional right-of-reply from the vendor"}
  }
}
